# Production overrides for AssureOps on a single Linux VPS.
# Do NOT put real secrets in git. On the VPS:
#   1. .venv/bin/python scripts/init_dev_env.py
#   2. Change ALLOW_PRIVATE_TARGETS=true -> ALLOW_PRIVATE_TARGETS=false in infra/compose/dev.env
#   3. Append this file (with your real API keys filled in) to infra/compose/dev.env

# --- Linux model storage (overrides Windows default in full-stack.yml) ---
ASSUREOPS_MODELS_DIR=/opt/assureops-models

# --- Public HTTPS origins (Caddy reverse proxy) ---
PUBLIC_CUSTOMER_ORIGIN=https://assureops-ai.rafidahad.me
PUBLIC_STAFF_ORIGIN=https://staff.assureops-ai.rafidahad.me
PUBLIC_AUTH_ORIGIN=https://auth.assureops-ai.rafidahad.me
CUSTOMER_OIDC_ISSUER=https://auth.assureops-ai.rafidahad.me/realms/assureops
STAFF_OIDC_ISSUER=https://auth.assureops-ai.rafidahad.me/realms/assureops-staff

# --- Production hardening ---
STAFF_MFA_REQUIRED=true
ALLOW_PRIVATE_TARGETS=false
ASSUREOPS_SEED_APPS=false

# --- E-mail (Resend; or configure NOTIFY_SMTP_* instead) ---
RESEND_API_KEY=
NOTIFY_FROM=AssureOps <no-reply@rafidahad.me>
NOTIFY_FROM_ADDRESS=no-reply@rafidahad.me

# --- Groq AI phases (phases A, C, E, F, G; D and R stay private-only on CPU encoder) ---
# After starting the stack, qualify each phase in Postgres with scripts/qualify_phase.py --record.
GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_MAX_PARAMS_B=120
GROQ_MODEL_A=openai/gpt-oss-20b
GROQ_MODEL_C=openai/gpt-oss-120b
GROQ_MODEL_E=openai/gpt-oss-20b
GROQ_MODEL_F=openai/gpt-oss-20b
GROQ_MODEL_G=meta-llama/llama-prompt-guard-2-86m
GROQ_DAILY_TOKEN_LIMIT_PER_WORKSPACE=60000
